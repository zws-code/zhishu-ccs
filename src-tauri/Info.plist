<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 使用独立协议，避免与原版 CC Switch 抢占深链接 -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Zhishu CC Switch Deep Link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>zhishu-ccswitch</string>
      </array>
    </dict>
  </array>

  <!-- macOS local-network privacy prompt for LAN API endpoints -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Zhishu CC Switch needs access to your local network to connect to local API endpoints.</string>
</dict>
</plist>
