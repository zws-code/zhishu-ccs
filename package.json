{
  "name": "zhishu-ccs",
  "version": "0.0.6",
  "description": "All-in-One Assistant for Claude Code, Codex & Gemini CLI",
  "type": "module",
  "scripts": {
    "dev": "node scripts/zhishu/dev-isolated.mjs",
    "test:dev-isolation": "node --test scripts/zhishu/dev-isolated.test.mjs",
    "test:dev-signing": "node --test scripts/zhishu/macos-dev-sign.test.mjs",
    "build": "node scripts/zhishu/build-release.mjs",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "release:prepare": "node scripts/zhishu/prepare-release.mjs",
    "release:tag": "node scripts/zhishu/tag-release.mjs",
    "test:release-tag": "node --test scripts/zhishu/tag-release.test.mjs",
    "test:release-config": "node --test scripts/zhishu/release-config.test.mjs",
    "test:release": "node --test scripts/zhishu/release-config.test.mjs scripts/zhishu/release-artifacts.test.mjs scripts/zhishu/cos-release.test.mjs scripts/zhishu/resume-release.test.mjs scripts/zhishu/tag-release.test.mjs",
    "release:check": "node scripts/zhishu/cos-release.mjs check",
    "test:release-cos": "python3 -B -m unittest discover -s scripts/zhishu -p 'test_publish_cos.py'"
  },
  "keywords": [],
  "author": "Jason Young",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "autoprefixer": "^10.6.2",
    "code-inspector-plugin": "^2.0.9",
    "cross-fetch": "^4.1.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-virtual": "^3.14.25",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "flexsearch": "^0.8.212",
    "framer-motion": "^14.9.0",
    "i18next": "^26.7.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.11",
    "recharts": "^3.10.1",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
