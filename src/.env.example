# Vite root is src/. Copy this file to src/.env.local for local overrides.
# Backend: API calls append /api/v1 automatically.
VITE_PLATFORM_API_URL=http://127.0.0.1:3000
# Web frontend: registration and password reset.
VITE_PLATFORM_WEB_URL=http://127.0.0.1:3081
# Production: set both values to the same HTTPS origin before building.
